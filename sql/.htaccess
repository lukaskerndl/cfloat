# Tato složka obsahuje provozní/osobní data (osobní údaje zákazníků,
# přepravní štítky, logy, cache dopravců, feedy). Přímý přístup z webu
# je zakázán – soubory smí číst pouze PHP na serveru.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

Options -Indexes
